{
  "name": "@chromatic-com/e2e-demo-vitest",
  "version": "1.0.0",
  "description": "Showcases a real-world demo of E2E Visual Tests with Chromatic and Vitest",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "test:storybook": "playwright test --config e2e/playwright.config.ts",
    "build": "build-archive-storybook",
    "preview": "archive-storybook",
    "chromatic": "chromatic --vitest --project-token=$CHROMATIC_PROJECT_TOKEN",
    "ecosystem-ci": "pnpm test --run && pnpm build && pnpm test:storybook"
  },
  "devDependencies": {
    "@chromatic-com/vitest": "latest",
    "@playwright/test": "1.61.0",
    "@types/node": "26.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/browser-playwright": "latest",
    "chromatic": "^17",
    "playwright": "1.61.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sass-embedded": "1.100.0",
    "vite": "^8",
    "vitest": "latest",
    "vitest-browser-react": "2.1.0"
  }
}
